# Environment Variables Configuration for Local & Vercel Deployment

# 1. MongoDB Database Connection String (MongoDB Atlas)
# Make sure to allow Network Access from anywhere (0.0.0.0/0) in MongoDB Atlas Security Settings for Vercel Serverless Functions.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/royal_academy?retryWrites=true&w=majority

# 2. System Admin Login Credentials (Optional - configured via environment variables)
ADMIN_EMAIL=admin@royalacademy.edu.ng
ADMIN_PASSWORD=

# 3. Gemini AI API Key (Optional)
GEMINI_API_KEY=

# 4. Cloudinary Configuration (Cloudinary Cloud Storage for Images)
# Get your Cloudinary credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or use full connection URL:
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
