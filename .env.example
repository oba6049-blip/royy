# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# MONGODB_URI: Connection string for MongoDB database (Optional)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/royal_academy?retryWrites=true&w=majority

# ADMIN_EMAIL & ADMIN_PASSWORD: Credentials for Administrator login (Optional)
ADMIN_EMAIL=admin@royalacademy.edu.ng
ADMIN_PASSWORD=admin123
